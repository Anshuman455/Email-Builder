{
  "name": "@email-builder/vue",
  "version": "0.3.0",
  "description": "Vue 3 bindings for the email builder. A thin view layer over @email-builder/engine.",
  "keywords": [
    "email",
    "email-builder",
    "email-editor",
    "drag-and-drop",
    "vue",
    "vue3"
  ],
  "license": "MIT",
  "author": "Anshuman Kumar Kushwaha",
  "homepage": "https://github.com/Anshuman455/Email-Builder/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/Anshuman455/Email-Builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anshuman455/Email-Builder.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "@email-builder/core": "0.3.0",
    "@email-builder/engine": "0.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
